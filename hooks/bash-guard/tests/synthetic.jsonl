{"cmd": "for f in $(ls paper/source/*.tex); do sed -i s/a/b/ $f; done", "expect": "block", "note": "loop over command output listing protected files"}
{"cmd": "./tools/x rfc 2>&1 | head -1 | grep -o 'file=[^ ]*'", "expect": "allow", "note": "text after = with a glob is not a path"}
{"cmd": "S=/tmp/s; for d in new old; do rm -rf $S/$d/data/x; done", "expect": "allow", "note": "a copy elsewhere ending in data/ is not the project's data/"}
