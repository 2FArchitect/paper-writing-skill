#!/bin/bash
#
# paper-writing-skill setup
#
# Usage:
#   git clone <repo-url>
#   cd paper-writing-skill
#   ./setup
#
# What this does:
#   Copies the skill into ~/.claude/skills/paper-writing/ so Claude Code
#   can discover and invoke it when you type /paper-writing.
#
# The skill works immediately with the SNL lab's writing rules as defaults.
# To customize, edit the files in author_profile/ — see the README.
#

set -e

SKILL_NAME="paper-writing"
SKILL_DIR="$HOME/.claude/skills/$SKILL_NAME"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

echo "=== Paper Writing Skill Setup ==="
echo ""

# Check if skill already exists
if [ -d "$SKILL_DIR" ]; then
    echo "Found existing skill at $SKILL_DIR"
    read -p "Overwrite? (y/N) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "Aborted."
        exit 0
    fi
    rm -rf "$SKILL_DIR"
fi

# Create the skill directory
mkdir -p "$SKILL_DIR"

# Copy all skill files (everything except setup, README, .git, examples).
# Markdown files are installed with their @path include lines expanded (scripts/expand_includes.py),
# so each installed file is whole; rules/ (the fragments) is not installed itself.
echo "Installing skill files..."
python3 - "$SCRIPT_DIR" "$SKILL_DIR" SKILL.md brainstorming_guide.md story_mode.md figure_synthesis_guide.md red_team_protocol.md loop_mode.md author_profile writing_checklists section_rhetorical_moves figure_templates hooks modes faq scripts <<'PYEOF'
import os, shutil, sys
src_root, dst_root, items = sys.argv[1], sys.argv[2], sys.argv[3:]
sys.dont_write_bytecode = True  # keep __pycache__ out of the source repo
sys.path.insert(0, os.path.join(src_root, "scripts"))
from expand_includes import expand

def install(src, dst):
    if src.endswith(".md"):
        with open(dst, "w", encoding="utf-8", newline="") as f:
            f.write(expand(src))
    else:
        shutil.copy(src, dst)

# Not installed: bash-guard's tests (tests/local holds a user's real commands) and Python caches.
SKIP_DIRS = {os.path.join("hooks", "bash-guard", "tests"), "__pycache__"}

for item in items:
    src = os.path.join(src_root, item)
    if not os.path.exists(src):
        continue
    dst = os.path.join(dst_root, item)
    if os.path.isdir(src):
        for dirpath, dirnames, filenames in os.walk(src):
            rel = os.path.relpath(dirpath, src_root)
            dirnames[:] = [d for d in dirnames
                           if d not in SKIP_DIRS and os.path.join(rel, d) not in SKIP_DIRS]
            out = os.path.join(dst, os.path.relpath(dirpath, src))
            os.makedirs(out, exist_ok=True)
            for name in filenames:
                install(os.path.join(dirpath, name), os.path.join(out, name))
    else:
        install(src, dst)
PYEOF

# Hook commands need an absolute path: Claude Code does not substitute ${CLAUDE_SKILL_DIR} in them.
python3 - "$SKILL_DIR/SKILL.md" "$SKILL_DIR/hooks/paper_guard.py" "$SKILL_DIR/hooks/bash-guard/install.py" <<'PYEOF'
import sys
path, guard, bash_guard_install = sys.argv[1], sys.argv[2], sys.argv[3]
with open(path) as f:
    text = f.read()
with open(path, "w") as f:
    f.write(text.replace("__PAPER_GUARD__", guard).replace("__BASH_GUARD_INSTALL__", bash_guard_install))
PYEOF

# Copy examples separately (students need the templates)
mkdir -p "$SKILL_DIR/examples"
cp -r "$SCRIPT_DIR/examples/"* "$SKILL_DIR/examples/"

# Enforcement hooks. The skill's own frontmatter hook marks a
# session as a /paper-writing session; these settings hooks enforce the rules in marked sessions,
# including their subagents (skill-frontmatter hooks do not run inside subagents).
SETTINGS="$HOME/.claude/settings.json"
echo "Installing enforcement hooks into $SETTINGS..."
if [ -f "$SETTINGS" ]; then
    cp "$SETTINGS" "$SETTINGS.bak-paper-writing-$(date +%Y%m%d-%H%M%S)"
fi
python3 - "$SETTINGS" "$SKILL_DIR/hooks/paper_guard.py" "$SKILL_DIR/hooks/bash-guard/pretooluse.py" <<'PYEOF'
import json, os, sys
settings_path, guard, bash_guard = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    with open(settings_path) as f:
        settings = json.load(f)
except FileNotFoundError:
    settings = {}

def ours(entry):
    return any("paper_guard.py" in h.get("command", "") or "bash-guard/pretooluse.py" in h.get("command", "")
               for h in entry.get("hooks", []))

def hook(sub):
    # A missing script makes python3 exit 2, which Claude Code treats as "block this tool call";
    # the test keeps a removed skill from blocking every Bash and Edit call.
    return {"type": "command", "command": f'test -f "{guard}" && python3 "{guard}" {sub} || true'}

# bash-guard: blocks Bash commands that may modify a project's protected files (projects opt in
# with .paper-writing/bash-guard.json). Same missing-script test as above.
bash_guard_hook = {"type": "command", "command": f'test -f "{bash_guard}" && python3 "{bash_guard}" || true'}

wanted = {
    "PreToolUse": [
        {"matcher": "Bash", "hooks": [hook("bash"), bash_guard_hook]},
        {"matcher": "Write|Edit|MultiEdit|NotebookEdit", "hooks": [hook("edit")]},
    ],
    "PostCompact": [{"hooks": [hook("compact")]}],
}
hooks = settings.setdefault("hooks", {})
for event in list(hooks):  # drop entries from an earlier install, keep everything else
    hooks[event] = [e for e in hooks[event] if not ours(e)]
    if not hooks[event]:
        del hooks[event]
for event, entries in wanted.items():
    hooks.setdefault(event, []).extend(entries)

TAG = "[paper-writing]"
rule = (f"{TAG} Writing or modifying .tex files through shell commands or scripts (redirects, "
        "heredocs, tee, sed -i, perl -i, inline python/perl/node, or running a script that opens "
        "a .tex file for writing). .tex files must be changed with the Write or Edit tools.")
soft = settings.setdefault("autoMode", {}).setdefault("soft_deny", ["$defaults"])
soft[:] = [r for r in soft if not r.startswith(TAG)] + [rule]

os.makedirs(os.path.dirname(settings_path), exist_ok=True)
tmp = settings_path + ".tmp"
with open(tmp, "w") as f:
    json.dump(settings, f, indent=2)
    f.write("\n")
os.replace(tmp, settings_path)
PYEOF

# bash-guard's Python runtime hook: a .pth file in each Python interpreter's site-packages that
# guards Python processes started by Claude Code's Bash commands. The skill's frontmatter hook
# re-runs this once per session, since a container rebuild removes site-packages changes.
echo "Installing bash-guard's Python runtime hook..."
python3 "$SKILL_DIR/hooks/bash-guard/install.py" || echo "  bash-guard: runtime hook not installed (see above)"

echo ""
echo "Installed to $SKILL_DIR"
echo ""
echo "To protect a project's files from shell writes, create <project>/.paper-writing/bash-guard.json,"
echo "for example: {\"protected\": [\"../paper/source\"]}  (see hooks/bash-guard/README.md)"
echo ""
echo "The skill is ready to use with the SNL lab's writing rules."
echo ""
echo "To use: open Claude Code in any project directory and type /paper-writing"
echo ""
echo "To start a new paper:"
echo "  1. cd into your paper's directory"
echo "  2. Open Claude Code"
echo "  3. Type /paper-writing"
echo "  4. Claude will walk you through creating a project_context.md"
echo ""
echo "To customize the voice rules for your own style:"
echo "  Edit files in $SKILL_DIR/author_profile/"
echo "  See the README for what to change in each file."
